# Supabase — find these in your Supabase project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Owner/admin accounts are real Supabase Auth users (Dashboard > Authentication > Users),
# each with a matching row in public.profiles. Nothing to configure here.
